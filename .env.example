# ── App ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
# Front (Next.js). En prod, CORS permite este origen + cualquier subdominio
# del mismo apex (multi-tenant). Ver src/main.ts.
WEB_APP_URL=http://localhost:3000
# Si =1 ejecuta `pnpm db:seed` al iniciar el contenedor (solo primer deploy).
# Volver a 0 después del primer arranque para no resembrarr.
RUN_SEED=0

# ── Database (Neon Postgres) ──────────────────────────────────────────────
# Pooled connection para runtime (PgBouncer)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require&pgbouncer=true"
# Conexión directa para migraciones
DIRECT_URL="postgresql://user:pass@host/db?sslmode=require"

# ── Auth ──────────────────────────────────────────────────────────────────
# Compartido con el front (Auth.js) para verificar JWT de sesión
JWT_SECRET="change-me-in-prod"
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Revalidation (webhook backend → front) ────────────────────────────────
REVALIDATE_SECRET="change-me"
# URL del front para disparar revalidación ISR
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate

# ── Stripe (Connect Express) ──────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Cuenta plataforma (billing de tenants, NO Connect)
STRIPE_PLATFORM_WEBHOOK_SECRET="whsec_..."

# ── Resend (emails) ───────────────────────────────────────────────────────
RESEND_API_KEY="re_..."
EMAIL_FROM="ORÍGEN <hola@bestcoffee.io>"

# ── Vercel Blob (uploads) ─────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN="vercel_blob_..."

# ── Inngest (jobs) ────────────────────────────────────────────────────────
# INNGEST_DEV=1 en local (Inngest Dev Server). En prod usar las keys reales.
INNGEST_DEV=1
INNGEST_EVENT_KEY="..."
INNGEST_SIGNING_KEY="..."

# ── Redis (Upstash) — rate-limit + cache catálogo ─────────────────────────
REDIS_URL="rediss://default:pass@host:6379"
