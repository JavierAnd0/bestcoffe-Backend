# ── App ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
# Front (Next.js). En prod, CORS permite este origen + cualquier subdominio
# del mismo apex (multi-tenant) + dominios registrados en TenantDomain. Ver src/main.ts.
WEB_APP_URL=http://localhost:3000
# Orígenes extra separados por coma (opcional)
CORS_EXTRA_ORIGINS=""
# Si =1 ejecuta `pnpm db:seed` al iniciar el contenedor (solo primer deploy).
# Volver a 0 después del primer arranque para no resembrar.
RUN_SEED=0
# Si =1 habilita Swagger (/docs y /docs-json) también en NODE_ENV=production.
ENABLE_SWAGGER=0
# Correo del superadministrador de plataforma (/v1/platform/*)
PLATFORM_OWNER_EMAIL="admin@bestcoffee.io"

# ── Database (Neon Postgres) ──────────────────────────────────────────────
# Pooled connection para runtime (PgBouncer)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require&pgbouncer=true"
# Conexión directa para migraciones
DIRECT_URL="postgresql://user:pass@host/db?sslmode=require"

# ── Auth ──────────────────────────────────────────────────────────────────
# Secreto principal para firmar JWT de operador y derivar por HMAC el de clientes.
# OBLIGATORIO y mínimo 32 chars (validado al arranque). Genera uno con:
#   openssl rand -base64 48
JWT_SECRET=""
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Revalidation & Internal Sync (backend ↔ front) ────────────────────────
# Mínimo 16 chars; obligatorio en producción. `openssl rand -base64 48`
# Usado tanto para disparar ISR en el front como para proteger POST /v1/auth/customer/neon-sync
# (header `x-internal-secret` o `x-revalidate-secret`).
REVALIDATE_SECRET=""
# URL del front para disparar revalidación ISR
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate

# ── Stripe (pagos y suscripciones) ────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PLATFORM_WEBHOOK_SECRET="whsec_..."

# ── MercadoPago (marketplace OAuth multi-tenant) ──────────────────────────
MP_CLIENT_ID=""
MP_CLIENT_SECRET=""
MP_WEBHOOK_SECRET=""
MP_REDIRECT_URI="http://localhost:3001/v1/mercadopago/oauth/callback"
MP_MARKETPLACE_FEE_PCT=0

# ── Resend (emails transaccionales) ───────────────────────────────────────
RESEND_API_KEY="re_..."
EMAIL_FROM="ORÍGEN <hola@bestcoffee.io>"

# ── Cloudflare Turnstile (CAPTCHA anti-bots) ──────────────────────────────
# Si se deja vacío en dev, TurnstileService permite el paso automáticamente.
TURNSTILE_SECRET_KEY=""

# ── Vercel Blob (uploads) ─────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN="vercel_blob_..."

# ── Inngest (jobs) ────────────────────────────────────────────────────────
# INNGEST_DEV=1 en local (Inngest Dev Server). En prod usar las keys reales.
INNGEST_DEV=1
INNGEST_EVENT_KEY="..."
INNGEST_SIGNING_KEY="..."

# ── Redis (Upstash) ───────────────────────────────────────────────────────
REDIS_URL="rediss://default:pass@host:6379"
